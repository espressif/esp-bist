{
    "write_flash_args" : [ "--flash-mode", "dio",
                           "--flash-size", "detect",
                           "--flash-freq", "40m" ],
    "flash_settings" : {
        "flash-mode": "dio",
        "flash-size": "detect",
        "flash-freq": "80m"
    },
    "flash_files" : {
        "0x10000" : "@APP_NAME@_signed.bin"
    },
    "app" : { "offset" : "0x10000", "file" : "@APP_NAME@_signed.bin", "encrypted" : "false" },
    "extra_esptool_args" : {
        "after"  : "no_reset",
        "before" : "default_reset",
        "stub"   : true,
        "chip"   : "@SOC_TARGET@"
    }
}
