/ {
	chosen {
		zephyr,ipc_shm = &ipc_shm;
		zephyr,ipc = &mbox0;
	};

	mbox-consumer {
		compatible = "vnd,mbox-consumer";
		mboxes = <&mbox0 1>, <&mbox0 0>;
		mbox-names = "tx", "rx";
	};
};

&ulp_ram {
	reg = <0x0 0x3e00>;
};

&ulp_shm {
	reg = <0x3df0 0x10>;
};

&ipc_shm {
	reg = <0x3ef8 0x10>;
};

&lp_uart {
	status = "okay";
};
