{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ESP32-C3 (OpenOCD)",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/${input:appPath}/build/${input:appName}.elf",
            "servertype": "openocd",
            "device": "ESP32-C3",
            "interface": "jtag",
            "configFiles": [
                "board/esp32c3-builtin.cfg"
            ],
            "openOCDPreConfigLaunchCommands":[
                "set ESP_RTOS none",
            ],
            "openOCDLaunchCommands": [
                "init; halt; esp appimage_offset 0x1000",
            ],
            "toolchainPrefix": "riscv32-esp-elf",
            "overrideAttachCommands": [
                "set pagination off",
                "mon reset halt"
            ],
            "postAttachCommands": [
                "thb __start",
                "continue"
            ],
            "overrideResetCommands": [
                "set pagination off",
                "mon reset halt",
                "thb __start",
                "continue"
            ],
            "svdFile": "${workspaceFolder}/src/soc/esp32c3/esp32c3.svd",
        },
    ],
    "inputs": [
        {
            "id": "appPath",
            "type": "promptString",
            "description": "Application path (e.g., samples/standalone or tests/cpu_reg_test)",
            "default": "samples/standalone"
        },
        {
            "id": "appName",
            "type": "promptString",
            "description": "Application name (e.g., standalone_critical_esp32c3 or cpu_reg_test)",
            "default": "standalone_critical_esp32c3"
        }
    ]
}
