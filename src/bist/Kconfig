mainmenu "Built In Self Test (BIST) Configuration"

config ESP_BIST
    bool "Enable Built In Self Test (BIST)"
    default y if !ZEPHYR_ESP_BIST_MODULE
    help
      Enable the built-in self-test (BIST) feature for the system.
      This feature allows for self-diagnosis and verification of system
      components during startup or at runtime.

menu "ESP-BIST Tests"
    depends on ESP_BIST

config ESP_BIST_CPU_REG_TEST
    bool "CPU Register Test"
    default y if !ZEPHYR_ESP_BIST_MODULE
    help
      Enable tests for CPU registers.

config ESP_BIST_CPU_CSR_REG_TEST
    bool "CPU CSR Register Test"
    default y if !ZEPHYR_ESP_BIST_MODULE
    help
      Enable tests for CPU Control and Status Registers (CSRs).

config ESP_BIST_MEMORY_RAM_TEST
    bool "Memory RAM Test"
    default y if !ZEPHYR_ESP_BIST_MODULE
    help
        Enable tests for the RAM memory integrity (March A, March X, and
        Abraham).

config ESP_BIST_RAM_PARTITION_SIZE
    int "RAM test partition size (words)"
    depends on ESP_BIST_MEMORY_RAM_TEST
    default 256 if IDF_ESP_BIST_COMPONENT || ZEPHYR_ESP_BIST_MODULE
    default 512
    help
        Size of each RAM test partition in 32-bit words. March A/X test one
        partition at a time; Abraham tests pairs. Larger values reduce the
        number of Abraham pairs C(N,2) and thus the execution time of
        bist_ram_test_abraham_full(), at the cost of a larger safe-RAM
        backup buffer (2 x partition_size x 4 bytes).

        Common values:
          256  = 1 KiB partitions, 2 KiB backup buffer (LP core default)
          512  = 2 KiB partitions, 4 KiB backup buffer (standalone default)
          1024 = 4 KiB partitions, 8 KiB backup buffer

config ESP_BIST_STACK_TEST
    bool "Stack Test"
    default y if !ZEPHYR_ESP_BIST_MODULE
    help
      Enable tests for the stack integrity.

config ESP_BIST_PROGRAM_COUNTER_TEST
    bool "Program Counter Test"
    depends on !IDF_ESP_BIST_COMPONENT && !ZEPHYR_ESP_BIST_MODULE
    default y
    help
      Enable tests for the program counter.

config ESP_BIST_MEMORY_FLASH_TEST
    bool "Memory Flash Test"
    default y if !ZEPHYR_ESP_BIST_MODULE
    help
      Enable tests for the Flash memory integrity.

config ESP_BIST_CLOCK_TEST
    bool "Clock Test"
    depends on !IDF_ESP_BIST_COMPONENT && !ZEPHYR_ESP_BIST_MODULE
    default y
    help
      Enable tests for the main crystal clock.

config ESP_BIST_GPIO_TEST
    bool "GPIO Test"
    depends on !IDF_ESP_BIST_COMPONENT && !ZEPHYR_ESP_BIST_MODULE
    default y
    help
      Enable tests for the GPIO pins.

config ESP_BIST_ADC_TEST
    bool "ADC Test"
    depends on !IDF_ESP_BIST_COMPONENT && !ZEPHYR_ESP_BIST_MODULE
    default y
    help
      Enable tests for the ADC pins.

config ESP_BIST_WATCHDOG_TEST
    bool "Watchdog Test"
    depends on !IDF_ESP_BIST_COMPONENT && !ZEPHYR_ESP_BIST_MODULE
    default y
    help
      Enable tests for the HP main watchdog timer (MWDT).

endmenu

config ESP_BIST_WDT_TIMEOUT_US
    int "WDT Timeout (us)"
    depends on ESP_BIST
    default 50000
    help
      Maximum time between watchdog feeds in microseconds.

      On the LP core (ESP-IDF ULP integration), this configures the LP WDT
      timeout via lp_wdt_init(). On HP core / standalone builds, this configures
      the main watchdog timer (MWDT).

config BIST_FLASH_TEST_CHUNK_SIZE
    hex "Flash Test Chunk Size"
    depends on ESP_BIST && ESP_BIST_MEMORY_FLASH_TEST
    default 0x1000
    help
      Specify the chunk size in bytes for flash memory testing.

config ESP_BIST_CLOCK_PERCENT_FREQUENCY_DRIFT
    int "Clock Frequency Drift Percentage"
    depends on ESP_BIST && ESP_BIST_CLOCK_TEST
    range 0 100
    default 1
    help
      Specify the acceptable percentage of frequency drift for the clock test.

config ESP_BIST_ADC_PERCENT_DEVIATION
    int "ADC Reading Deviation Percentage"
    depends on ESP_BIST_ADC_TEST
    range 0 100
    default 6
    help
      Specify the acceptable percentage deviation of ADC readings from
      the expected low or high reference values for the ADC plausibility tests.

config ESP_BIST_FLASH_SIZE
    hex "Flash Size"
    depends on ESP_BIST && !IDF_ESP_BIST_COMPONENT && !ZEPHYR_ESP_BIST_MODULE
    default 0x400000
    help
      Specify the size of the flash memory in bytes.

config ESP_BIST_HEAP_SIZE
    hex "Heap Size"
    depends on ESP_BIST && !IDF_ESP_BIST_COMPONENT && !ZEPHYR_ESP_BIST_MODULE
    default 0x1000
    help
      Specify the size of the heap in bytes. This is used for dynamic memory allocation
      during BIST operations. A value of 0 means no heap is allocated.

config ESP_BIST_STACK_PROTECTION_BLOCK_SIZE
    hex "Stack Protection Block Size"
    depends on ESP_BIST && !IDF_ESP_BIST_COMPONENT && !ZEPHYR_ESP_BIST_MODULE
    default 0x100
    help
      Specify the size of the stack protection block in bytes. This is used to protect
      the stack from overflow and underflow conditions. A value of 0 means no protection
      block is allocated.

config ESP_BIST_WDT_WINDOWED_UNDERFLOW_TIMEOUT_US
    int "WDT Windowed Underflow Timeout (us)"
    depends on ESP_BIST && !IDF_ESP_BIST_COMPONENT && !ZEPHYR_ESP_BIST_MODULE
    default 10
    help
      Specify the timeout for the windowed underflow condition in microseconds.
      This is used to ensure that the watchdog timer does not trigger an underflow
      condition during application time-slot.

config ESP_BIST_METRICS
    bool "BIST Metrics Collection"
    depends on ESP_BIST && !IDF_ESP_BIST_COMPONENT && !ZEPHYR_ESP_BIST_MODULE
    default y
    help
      Enable the collection of performance metrics during BIST operations, such as
      execution time, CPU cycles, and instruction counts.
